{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyCreationWithoutCostCenter",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "Null": {
          "aws:RequestTag/CentroDeCostos": "true"
        }
      }
    }
  ]
}